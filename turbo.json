{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [".env.local", ".env"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": ["{DIR}/.next/**", "{DIR}/dist/**", "{DIR}/build/**"],
      "dependsOn": ["^build"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    }
  }
}
